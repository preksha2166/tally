# Copy this file to .env.local and fill it in. See docs/SETUP.md.

# Firebase web app config: Firebase console > Project settings > General > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (Firebase AI Logic requires it). See docs/SETUP.md step 4.
# "enterprise" = Fraud Defense (formerly reCAPTCHA Enterprise) key ID, "v3" = classic reCAPTCHA v3 site key.
VITE_RECAPTCHA_PROVIDER=enterprise
VITE_RECAPTCHA_SITE_KEY=

# Local development only. Any random UUID, e.g. in PowerShell: [guid]::NewGuid().ToString()
# Register this exact value in Firebase console > App Check > Apps > (your web app) > Manage debug tokens.
# Keep it private: anyone who has it can pass App Check for your project.
VITE_APPCHECK_DEBUG_TOKEN=
