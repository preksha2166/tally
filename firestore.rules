rules_version = '2';
// TAlly stores only grading metadata in Firestore (scores, skill levels, approved feedback).
// Raw student answers never leave the TA's browser. Each TA can only read and write their own data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /tas/{taId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == taId;
    }
  }
}
